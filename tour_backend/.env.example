# Default DB: PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=travelweb
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional SQLite fallback (explicit opt-in)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# CORS (set to 0 in prod and specify allowed origins instead)
CORS_ALLOW_ALL_ORIGINS=1
# In production (recommended):
# CORS_ALLOW_ALL_ORIGINS=0
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com

# Django (production)
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com,localhost,127.0.0.1

# Uploaded media files
# DJANGO_MEDIA_URL=/media/
# DJANGO_MEDIA_ROOT=/home/your_pythonanywhere_username/TravelWeb/tour_backend/media
# DJANGO_STATIC_URL=/static/
# DJANGO_STATIC_ROOT=/home/your_pythonanywhere_username/TravelWeb/tour_backend/staticfiles
# DJANGO_PUBLIC_BASE_URL=https://your_pythonanywhere_username.pythonanywhere.com

# Currency conversion
# Base currency for stored amounts (recommended: KGS)
CURRENCY_BASE=KGS
# "Base units per 1 unit of currency"
# Example: 1 USD = 89.5 KGS, 1 EUR = 97.2 KGS
# Formats supported: JSON or CSV-like
CURRENCY_RATES=USD=89.5,EUR=97.2,RUB=1.02

AI_PROVIDER=huggingface
GEMINI_API_KEY=your_key_here
HF_API_KEY=your_huggingface_token
HF_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
HF_API_URL=https://router.huggingface.co/v1/chat/completions

# Optional: improves admin coordinate picker place search (uses Mapbox instead of OSM Nominatim)
# MAPBOX_TOKEN=pk....
